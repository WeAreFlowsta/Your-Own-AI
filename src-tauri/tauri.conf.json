{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Your Own AI",
  "mainBinaryName": "your-own-ai",
  "version": "0.9.1-beta.6",
  "identifier": "com.solar.yourowai",
  "build": {
    "beforeDevCommand": "rm -rf node_modules/.vite .qwik tmp dist 2>/dev/null; npm run dev",
    "devUrl": "http://localhost:5173/chat/",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Your Own AI",
        "width": 1100,
        "height": 700,
        "url": "/chat/",
        "backgroundColor": "#e3e5fdff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https://raw.githubusercontent.com https://api.github.com https://yourownai.net https://huggingface.co https://*.huggingface.co; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' blob: data: https://yourownai.net https://raw.githubusercontent.com",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "scope": [
          "**"
        ]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main app permissions",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "opener:default",
            {
              "identifier": "opener:allow-open-url",
              "allow": [
                {
                  "url": "https://yourownai.net/*"
                },
                {
                  "url": "https://*.yourownai.net/*"
                },
                {
                  "url": "https://flowsta.com/*"
                },
                {
                  "url": "https://docs.astral.sh/*"
                },
                {
                  "url": "https://git-scm.com/*"
                },
                {
                  "url": "https://nodejs.org/*"
                },
                {
                  "url": "https://github.com/*"
                },
                {
                  "url": "https://projects.blender.org/*"
                },
                {
                  "url": "https://www.blender.org/*"
                },
                {
                  "url": "https://blender.org/*"
                }
              ]
            },
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "shell:allow-open",
            "dialog:default",
            "http:default",
            "store:default",
            "store:allow-load",
            "store:allow-save",
            {
              "identifier": "http:allow-fetch",
              "allow": [
                {
                  "url": "http://localhost:*"
                },
                {
                  "url": "http://127.0.0.1:*"
                }
              ]
            }
          ]
        }
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Your Own AI",
    "shortDescription": "Offline-first AI App",
    "longDescription": "A powerful offline-first AI assistant that runs locally on your machine. Chat with AI models without requiring an internet connection.",
    "homepage": "https://yourownai.net",
    "license": "AGPL-3.0-or-later",
    "category": "Productivity",
    "externalBin": [
      "bin/yourowai-llama-server",
      "binaries/yourowai-holochain",
      "binaries/yourowai-lair-keystore",
      "binaries/yourowai-holochain-07",
      "binaries/yourowai-lair-keystore-07"
    ],
    "resources": [
      "resources/*.happ",
      "resources/*.wasm",
      "resources/pdfium/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/share/metainfo/com.solar.yourowai.metainfo.xml": "linux/com.solar.yourowai.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/com.solar.yourowai.metainfo.xml": "linux/com.solar.yourowai.metainfo.xml"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "signCommand": {
        "cmd": "pwsh",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/sign-windows.ps1",
          "%1"
        ]
      },
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2REQ2RUI0RDBFOUQ5QkMKUldTODJlblF0RzdkZG5Za2dWK2hTVUxONTN4T0Y5NmhlWHNKQyt3OVdnT24vRHYrWDdRWDhxeG0K",
      "endpoints": []
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "yourownai"
        ]
      }
    }
  }
}
