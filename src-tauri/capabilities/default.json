{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://yourownai.net/*" },
        { "url": "https://*.yourownai.net/*" },
        { "url": "https://flowsta.com/*" }
      ]
    },
    "shell:allow-execute",
    "shell:allow-spawn",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load"
  ]
}
